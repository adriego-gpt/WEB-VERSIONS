# Desarrollo local
# Puedes definir multiples origenes separados por coma o espacios.
# Ejemplo: http://localhost:5173 http://192.168.1.10:5173
# Nota: en desarrollo (npm run dev -- --host), la API ya acepta origenes LAN locales
# para evitar bloqueos desde celular aunque cambie la IP del router.
USER_ALLOWED_ORIGIN=http://localhost:5173
ADMIN_ALLOWED_ORIGIN=http://localhost:5173

# Persistencia compartida (recomendada para Vercel)
# Configura Vercel KV para que productos, pedidos y usuarios se sincronicen en todos los dispositivos.
KV_REST_API_URL=
KV_REST_API_TOKEN=
STORE_STATE_KEY=atelier:store:v1
STORE_LOCK_TTL_SECONDS=8
STORE_LOCK_MAX_WAIT_MS=2600
STORE_LOCK_RETRY_MS=110
CHECKOUT_IDEMPOTENCY_TTL_HOURS=72
MAX_JSON_BODY_BYTES=4194304
MAX_INLINE_IMAGE_BYTES=389120
MAX_DEV_API_BODY_BYTES=4194304

# Produccion
# Define solo tus dominios reales.
# Puedes usar comodines por host:
# USER_ALLOWED_ORIGIN=https://tu-dominio.com,https://*.vercel.app
USER_SESSION_SECRET=
USER_SESSION_HOURS=72
USER_PASSWORD_RESET_BASE_URL=https://tu-dominio.com
USER_PASSWORD_RESET_TTL_MINUTES=30

# ADMIN_ALLOWED_ORIGIN=https://tu-dominio.com,https://*.vercel.app
ADMIN_USERNAME=adriego-admin
ADMIN_EMAIL=soporte@tu-dominio.com
ADMIN_PASSWORD_ALGORITHM=scrypt
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=6
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# Envio de correo para recuperacion de contrasena.
# Proveedor recomendado: Resend (plan gratuito) o Gmail SMTP con App Password.
PASSWORD_RESET_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@tu-dominio.com

# Alternativa SMTP (Gmail): usa una App Password de Google.
# PASSWORD_RESET_EMAIL_PROVIDER=smtp o gmail-smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Alternativa: endpoint propio que reciba JSON.
PASSWORD_RESET_EMAIL_ENDPOINT=
PASSWORD_RESET_EMAIL_BEARER=
PASSWORD_RESET_EMAIL_API_KEY=
PASSWORD_RESET_EMAIL_FROM=no-reply@tu-dominio.com
PASSWORD_RESET_EMAIL_TIMEOUT_MS=10000
