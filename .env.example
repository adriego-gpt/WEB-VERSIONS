# ===================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - ATELIER / ADRIEGO STORE
# ===================================================================
# Todas las credenciales, claves de API y datos sensibles deben
# definirse aquí (.env local) o en el panel de Vercel (Project -> Settings -> Environment Variables).
# NUNCA guardes claves reales en archivos que se suban a Git.
# ===================================================================

# -------------------------------------------------------------------
# 1. SEGURIDAD Y ORÍGENES PERMITIDOS (CORS)
# -------------------------------------------------------------------
USER_ALLOWED_ORIGIN=http://localhost:5173
ADMIN_ALLOWED_ORIGIN=http://localhost:5173
# Mantén esta URL en Vercel hasta comprar y validar el dominio.
# Luego usa https://adriego.shop y actualiza los orígenes y la URL de recuperación.
PUBLIC_SITE_URL=https://adriego.vercel.app

# -------------------------------------------------------------------
# 2. PERSISTENCIA DE DATOS (Vercel KV / Upstash Redis)
# -------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
STORE_STATE_KEY=atelier:store:v1
STORE_LOCK_TTL_SECONDS=8
STORE_LOCK_MAX_WAIT_MS=2600
STORE_LOCK_RETRY_MS=110
CHECKOUT_IDEMPOTENCY_TTL_HOURS=72
MAX_JSON_BODY_BYTES=4194304
MAX_INLINE_IMAGE_BYTES=389120
MAX_DEV_API_BODY_BYTES=4194304
# Persiste una muestra del 10% de respuestas exitosas; rechazos y errores se guardan siempre.
SECURITY_METRICS_SUCCESS_SAMPLE_RATE=0.1

# -------------------------------------------------------------------
# 2B. IMÁGENES DEL CATÁLOGO (ImageKit)
# -------------------------------------------------------------------
# Copia estos tres valores desde ImageKit -> Developer options.
# IMAGEKIT_PRIVATE_KEY es exclusiva del servidor y NUNCA debe usar prefijo VITE_.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_imagekit_id

# -------------------------------------------------------------------
# 3. SESIONES Y RECUPERACIÓN DE USUARIOS
# -------------------------------------------------------------------
USER_SESSION_SECRET=
USER_SESSION_HOURS=72
USER_PASSWORD_RESET_BASE_URL=https://adriego.vercel.app
USER_PASSWORD_RESET_TTL_MINUTES=30

# -------------------------------------------------------------------
# 4. ADMINISTRADOR (Credenciales y Seguridad)
# -------------------------------------------------------------------
ADMIN_USERNAME=adriego-admin
ADMIN_EMAIL=soporte@adriego.store
ADMIN_PASSWORD_ALGORITHM=scrypt
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=6
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# -------------------------------------------------------------------
# 5. ENVÍO DE CORREOS TRANSACCIONALES (Recuperación de Contraseña)
# -------------------------------------------------------------------
# OPCIÓN A: Brevo API v3 (Activo y Recomendado)
PASSWORD_RESET_EMAIL_PROVIDER=brevo
PASSWORD_RESET_EMAIL_API_KEY=
PASSWORD_RESET_EMAIL_BEARER=
PASSWORD_RESET_EMAIL_FROM=adriegostorerecovery@gmail.com
PASSWORD_RESET_EMAIL_TIMEOUT_MS=10000

# OPCIÓN B: Resend (Alternativa)
# PASSWORD_RESET_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@tu-dominio.com

# OPCIÓN C: Gmail SMTP (App Password de Google)
# PASSWORD_RESET_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=

# -------------------------------------------------------------------
# 6. NOTIFICACIONES (Telegram Bot y N8N Webhook)
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
N8N_ORDER_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# -------------------------------------------------------------------
# 7. ANALÍTICA PRIVADA (Umami Cloud)
# -------------------------------------------------------------------
# Identificador público del sitio en Umami. Déjalo vacío para no cargar el tracker.
# El código solo acepta un UUID válido y limita la medición a adriego.shop.
VITE_UMAMI_WEBSITE_ID=
