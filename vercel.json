{
  "framework": "vite",
  "functions": { "api/seo.js": { "includeFiles": "dist/app.html" } },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(adriego-icon.png|adriego-logo.png|adriego-share.png|favicon.svg|manifest.json|og-cover.jpg|llms.txt|762a2b370a8eaa34badf3cf58c7e7d37.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" } ]
    },
    {
      "source": "/cuenta/:path*",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" } ]
    },
    {
      "source": "/(carrito|favoritos|pedidos|buscar)",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" } ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://upload.imagekit.io https://cloud.umami.is; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo?action=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?action=sitemap-index"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/seo?action=sitemap-pages"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/seo?action=sitemap-products"
    },
    {
      "source": "/",
      "destination": "/api/seo?action=page&path=/"
    },
    {
      "source": "/producto/:slug",
      "destination": "/api/seo?action=page&path=/producto/:slug"
    },
    {
      "source": "/legal/:document",
      "destination": "/api/seo?action=page&path=/legal/:document"
    },
    {
      "source": "/:name.xml",
      "destination": "/api/seo?action=page&path=/:name.xml"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/app.html"
    }
  ]
}
